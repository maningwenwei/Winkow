{
  "name": "moyu-float",
  "productName": "Winkow",
  "version": "1.0.62",
  "description": "Winkow",
  "main": "src/main/index.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.18.0",
    "koffi": "^2.16.4"
  },
  "build": {
    "appId": "com.moyufloat.float",
    "productName": "Winkow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "tools/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "airplay",
        "to": "airplay"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Winkow",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Winkow-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Winkow-${version}-portable.${ext}"
    }
  }
}
